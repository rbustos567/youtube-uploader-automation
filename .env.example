# ==============================================================================
# YOUTUBE AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- Notification Settings ---
NOTIFICATION_EMAIL=user@example.com
GMAIL_APP_PASSWORD=
NOTIFICATION_CREDENTIAL_ID=gmail-app-password

# --- AI & Ollama Topology ---
# Use http://host.docker.internal:11434 if Ollama runs natively on the host
OLLAMA_HOST_URL=http://ollama-service:11435
OLLAMA_MODEL_NAME=gemma2:9b

# --- Localization Settings ---
SYSTEM_TIMEZONE=America/Monterrey

# --- Automation & Scheduling ---
# Default: Every Saturday at 2:05 pm (5 14 * * 6)
PIPELINE_CRON_SCHEDULE=5 14 * * 6

# --- Jenkins Authentication (Managed by Installer) ---
JENKINS_INITIAL_ADMIN_USER=
JENKINS_INITIAL_ADMIN_PASSWORD=

# --- Jenkins Project --- 
JENKINS_PROJECT_NAME=youtube-automation-sandbox
JENKINS_GITHUB_REPO_URL=https://github.com/rbustos567/youtube-uploader-automation.git

# --- Deployment Paths ---
# The installer will automatically populate this with the current path
DEPLOY_WORKSPACE_PATH=
