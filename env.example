# ==============================================================================
# YOUTUBE AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- Notification Settings ---
NOTIFICATION_EMAIL=user@example.com

# --- AI & Ollama Topology ---
# Use http://host.docker.internal:11434 if Ollama runs natively on the host
OLLAMA_HOST_URL=http://ollama-service:11434
OLLAMA_MODEL_NAME=gemma2:9b

# --- Localization Settings --
SYSTEM_TIMEZONE=America/Monterrey

# --- Deployment Paths ---
# The installer will automatically populate this with the current path
DEPLOY_WORKSPACE_PATH=
